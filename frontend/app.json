{
  "expo": {
    "name": "AMASS",
    "slug": "frontend",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/amass-icon-square.png",
    "scheme": "amass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amassafrica.app",
      "usesAppleSignIn": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAknqfu3Tx0v_XwLHMaGRj5fMQ7rJxYYLY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Discover properties near you on the map",
        "NSPhotoLibraryUsageDescription": "Choose photos for your property listings",
        "NSCameraUsageDescription": "Take photos of properties to list on AMASS",
        "NSMicrophoneUsageDescription": "Record voice notes to send in chat",
        "NSContactsUsageDescription": "Find friends already on AMASS to shortlist homes together"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/amass-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.amassafrica.app",
      "versionCode": 109,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAknqfu3Tx0v_XwLHMaGRj5fMQ7rJxYYLY"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of your property to list on AMASS",
          "cameraPermission": "Take photos of your property to list on AMASS"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/amass-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-vector-icons/ionicons",
      "expo-asset",
      [
        "expo-contacts",
        {
          "contactsPermission": "Find friends already on AMASS to shortlist homes together"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}