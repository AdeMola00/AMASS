{
  "expo": {
    "name": "AMASS Partner",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/amass-icon-square.png",
    "scheme": "amasspartner",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.amasspreview.jup7r1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of homes and items you list",
        "NSPhotoLibraryUsageDescription": "Add photos to your listings",
        "NSMicrophoneUsageDescription": "Send voice messages to your customers"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/amass-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.amasspreview.jup7r1",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/amass-emblem.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F3"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add photos to your listings",
          "cameraPermission": "Take photos of homes and items you list"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-audio",
        {
          "microphonePermission": "Send voice messages to your customers"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}