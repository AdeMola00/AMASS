{
  "expo": {
    "name": "AMASS",
    "slug": "frontend",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/amass-icon.png",
    "scheme": "amass",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amassafrica.app",
      "usesAppleSignIn": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAknqfu3Tx0v_XwLHMaGRj5fMQ7rJxYYLY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Discover properties near you on the map",
        "NSPhotoLibraryUsageDescription": "Choose photos for your property listings",
        "NSPhotoLibraryAddUsageDescription": "Save AMASS flyers and QR codes to your camera roll",
        "NSCameraUsageDescription": "Take photos of properties to list on AMASS",
        "NSMicrophoneUsageDescription": "Record voice notes to send in chat"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/amass-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.amassafrica.app",
      "versionCode": 2,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAknqfu3Tx0v_XwLHMaGRj5fMQ7rJxYYLY"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of your property to list on AMASS",
          "cameraPermission": "Take photos of your property to list on AMASS"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AMASS saves your property flyers and QR codes to Photos.",
          "savePhotosPermission": "AMASS saves your property flyers and QR codes to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/amass-logo-full.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-vector-icons/ionicons",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
